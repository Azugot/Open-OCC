# Required. Choose a strong database password before starting.
POSTGRES_DB=storyapp
POSTGRES_USER=storyapp
POSTGRES_PASSWORD=change-me
# Optional: host port. The application binds only to loopback by default.
APP_PORT=8080
# Optional: bearer access token. Leave blank only for local single-user use.
# The UI asks for this token when configured; never put it in a VITE variable.
APP_ACCESS_TOKEN=
# Provider credentials are passed only to the backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_DEFAULT_MODEL=
LEMONADE_BASE_URL=http://host.docker.internal:13305/v1
# Optional unless LEMONADE_API_KEY is configured on the Lemonade server.
LEMONADE_API_KEY=
LEMONADE_DEFAULT_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=
# Profile IDs: fixture, openai, anthropic, deepseek, kimi, lemonade, ollama, character, director.
# Story agents use separate selectable profiles. Leave fixture for a no-key demonstration.
CHARACTER_PROVIDER=character
DIRECTOR_PROVIDER=director
CHARACTER_ADAPTER=fixture
DIRECTOR_ADAPTER=fixture
CHARACTER_MODEL=fixture-v1
DIRECTOR_MODEL=fixture-v1
# Role overrides; OpenAI/Ollama roles can inherit the vendor settings above.
CHARACTER_API_KEY=
DIRECTOR_API_KEY=
CHARACTER_BASE_URL=
DIRECTOR_BASE_URL=
# Fixture is safe by default. Configure, enable, test, and route live profiles in the UI.
NARRATION_PROVIDER=fixture
RECONSTRUCTION_PROVIDER=fixture
MEMORY_PROVIDER=fixture
