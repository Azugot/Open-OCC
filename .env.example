# Required. Choose a strong database password before starting.
POSTGRES_DB=storyapp
POSTGRES_USER=storyapp
POSTGRES_PASSWORD=change-me
# Optional: host port. The application binds only to loopback by default.
APP_PORT=8080
# Optional: bearer access token. Leave blank only for local single-user use.
# The UI asks for this token when configured; never put it in a VITE variable.
APP_ACCESS_TOKEN=
# Provider credentials are passed only to the backend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_DEFAULT_MODEL=
KIMI_API_KEY=
KIMI_BASE_URL=
KIMI_DEFAULT_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_DEFAULT_MODEL=
# Profile IDs: fixture, openai, anthropic, deepseek, kimi, ollama.
# Foundation enables fixture turns only; remote adapters are explicit stubs.
NARRATION_PROVIDER=fixture
NARRATION_MODEL=fixture-v1
RECONSTRUCTION_PROVIDER=fixture
RECONSTRUCTION_MODEL=deterministic-v1
MEMORY_PROVIDER=fixture
MEMORY_MODEL=fixture-v1
